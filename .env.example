# Copy to .env.local. Do not commit real values.

# Neon PostgreSQL connection string for this portfolio.
# Use the pooled connection string for the app.
DATABASE_URL=

# Optional. Direct (non-pooler) URL for prisma migrate. If unset, migrate strips -pooler from DATABASE_URL.
DATABASE_URL_UNPOOLED=

# openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App. GitHub → Settings → Developer settings → OAuth Apps.
# Add every callback you actually use, exact match, no trailing slash:
#   http://localhost:3000/api/auth/callback/github
#   https://edrisastudio.com/api/auth/callback/github
#   https://edrisa-portfolio.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Production canonical origin for Auth.js cookies and redirects.
AUTH_URL=https://edrisastudio.com

# Neon Object Storage for portfolio images. Written by `neon env pull -s object-storage`.
# Bucket: edrisa-media (public read). Files are not stored in Postgres.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Object-key prefix. Local: development. Preview: preview. Production: production.
MEDIA_NAMESPACE=

# Preview only. Do not set this locally or in Production.
# Auth.js appends /callback/github and sends that exact URL to GitHub.
AUTH_REDIRECT_PROXY_URL=

# Google Search Console HTML-tag verification token (content= value only).
GOOGLE_SITE_VERIFICATION=

# Optional GA4 measurement id (G-…).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Wikidata item URL for Kasibante Edrisa, added to Person sameAs when set.
WIKIDATA_ENTITY_URL=
