# Copy to .env.local. Do not commit real values.

# Neon PostgreSQL connection string for this portfolio.
# Use the pooled connection string for the app.
DATABASE_URL=

# openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App. Callback: {origin}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Neon Object Storage for portfolio images. Written by `neon env pull -s object-storage`.
# Bucket: edrisa-media (public read). Files are not stored in Postgres.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Object-key prefix. Local: development. Preview: preview. Production: production.
MEDIA_NAMESPACE=

# Preview only. Do not set this locally or in Production.
# Auth.js appends /callback/github and sends that exact URL to GitHub.
AUTH_REDIRECT_PROXY_URL=
